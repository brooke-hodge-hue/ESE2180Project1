function [A,b] = buildSystem(resistanceData,voltageData)

n = 25; %Setting up our dimensions for A and b 
A = zeros(n,n); %Making a zeros matrix of A that is nxn 
b = zeros(n,1); %Making the zeros vector that is nx1 

%We must loop through the rows of the Resistance data (which has 40 rows)
%We are creating Matrix A
for k = 1:size(resistanceData,1)
    %Need to get the nodes connected to eahc resistor and the resistance
    %value from that row 
    node1 = resistanceData(k,1);
    node2 = resistanceData(k,2);
    R = resistanceData(k,3);

    %We have found that the pattern of this resistpr network is
    %Vcurrentnode-Vneighbor/2 -> +1/R cuurent and -1/R neighbor

    %Add the resistance to node 1 
    A(node1,node1) = A(node1,node1)+1/R;
    A(node1,node2) = A(node1,node2)-1/R;

    %Now add the node 2
    A(node2,node2) = A(node2,node2)+1/R;
    A(node2,node1) = A(node2,node1)-1/R;
end 

%now we are using the volatges to create vector b 
%again we need a for loop 

